---
import BaseLayout from '../layouts/BaseLayout.astro';
import FullGraph from '../components/FullGraph';

// ── Featured jump-off points ─────────────────────────────────────────────────
// Update these to whatever notes you want to surface for first-time visitors.
const jumpOff = [
  {
    label: 'What is this?',
    slug: 'digital-garden',
    desc: 'The idea behind the garden and how to navigate it.',
  },
  {
    label: 'The Bookshelf',
    slug: 'books',
    desc: "Books I've read across fiction, non-fiction, and business.",
  },
  {
    label: 'Materials & Making',
    slug: 'thermoform',
    desc: 'Notes on plastics, fabrication, and physical creation.',
  },
  {
    label: 'Business',
    slug: 'business-books',
    desc: 'Business books, strategy, and entrepreneurship.',
  },
];

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Ryan's Garden"
  description="A digital garden — non-linear notes on design, making, books, business, and whatever I'm currently thinking about."
>
  <div class="home-layout">

    <!-- ── Left: intro panel ────────────────────────────────────────── -->
    <div class="home-intro">
      <div class="home-content">

        <header class="home-header">
          <h1>Ryan's Garden</h1>
          <p class="home-tagline">
            Notes on design, making, books, business, and whatever I'm currently thinking about.
          </p>
        </header>

        <div class="home-body">
          <p>
            A digital garden is what happens before the blog post — rougher, more honest, and built around connections rather than chronology.
            Notes here range from half-formed seeds to fully developed ideas. The rough edges are intentional.
          </p>
          <p>
            The graph on the right <em>is</em> the navigation. Nodes are notes, edges are the links between them.
            There's no set path — wander where you like.
          </p>
        </div>

        <!-- ── Jump-off cards ──────────────────────────────────────── -->
        <div class="home-jumpoff">
          <p class="home-jumpoff-label">Start somewhere</p>
          <div class="home-cards">
            {jumpOff.map((item) => (
              <a href={`${base}notes/${item.slug}`} class="home-card">
                <span class="home-card-title">{item.label}</span>
                <span class="home-card-desc">{item.desc}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- ── Full graph CTA ─────────────────────────────────────── -->
        <a href={`${base}graph`} class="home-enter-graph">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
          </svg>
          Explore the full graph
        </a>

        <!-- ── Graph hint ──────────────────────────────────────────── -->
        <p class="home-hint">
          Click any node to open a note &nbsp;·&nbsp; right-click to zoom &nbsp;·&nbsp; click a tag to filter
        </p>

      </div>
    </div>

    <!-- ── Right: 3D graph ─────────────────────────────────────────── -->
    <div class="home-graph">
      <FullGraph client:only="react" />
    </div>

  </div>
</BaseLayout>

<style is:global>
  /* Lock the home page to the viewport — prevents any outer page scroll */
  html, body { overflow: hidden; height: 100%; }
</style>

<style>
  /* ── Layout ─────────────────────────────────────────────────────── */
  .home-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 100vh;
    overflow: hidden;
  }

  /* ── Intro panel ─────────────────────────────────────────────────── */
  .home-intro {
    overflow-y: auto;
    padding: 1.75rem 2rem 1.75rem 2.5rem;
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    justify-content: center;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .home-intro::-webkit-scrollbar       { width: 4px; }
  .home-intro::-webkit-scrollbar-track { background: transparent; }
  .home-intro::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

  .home-content {
    width: 100%;
    max-width: 520px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* ── Header ─────────────────────────────────────────────────────── */
  .home-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
    line-height: 1.15;
  }

  .home-tagline {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* ── Body copy ───────────────────────────────────────────────────── */
  .home-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .home-body p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }
  .home-body em {
    font-style: italic;
    color: var(--text-primary);
  }

  /* ── Jump-off section ────────────────────────────────────────────── */
  .home-jumpoff-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  .home-cards {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .home-card {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .home-card:hover {
    border-color: var(--accent);
    background: var(--bg-surface-2);
    text-decoration: none;
  }

  .home-card-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }

  .home-card-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  /* ── Full graph CTA ──────────────────────────────────────────────── */
  .home-enter-graph {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent);
    background: rgba(52, 152, 219, 0.08);
    border: 1px solid rgba(52, 152, 219, 0.25);
    border-radius: 20px;
    padding: 6px 16px 6px 12px;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
    width: fit-content;
  }
  .home-enter-graph:hover {
    background: rgba(52, 152, 219, 0.16);
    border-color: rgba(52, 152, 219, 0.5);
    text-decoration: none;
  }

  /* ── Graph hint ─────────────────────────────────────────────────── */
  .home-hint {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.5;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  /* ── Graph panel ─────────────────────────────────────────────────── */
  .home-graph {
    position: relative;
    overflow: hidden;
    background: var(--graph-bg);
  }

  /* ── Mobile: stack vertically ─────────────────────────────────────── */
  @media (max-width: 860px) {
    .home-layout {
      grid-template-columns: 1fr;
      height: auto;
      overflow: visible;
    }
    .home-intro {
      border-right: none;
      border-bottom: 1px solid var(--border);
      padding: 1.5rem;
      justify-content: flex-start;
    }
    .home-graph {
      height: 65vh;
    }
  }
</style>
